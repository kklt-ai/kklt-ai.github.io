---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
import { wechatArticles } from '../data/wechat-articles';
import avatar from '../assets/avatar.jpg';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const recentPosts = posts.slice(0, 3);
---

<BaseLayout title="卡卡罗特AI · 手绘博客">
  <!-- ===== Hero ===== -->
  <section class="hero container">
    <div class="hero-text">
      <p class="hello">你好，我是</p>
      <h1 class="name">
        卡卡罗特<span class="ai-badge">AI</span>
        <svg class="squiggle-underline" viewBox="0 0 220 14" aria-hidden="true">
          <path
            d="M4 8 Q20 2 36 8 T68 8 T100 8 T132 8 T164 8 T196 8 T216 8"
            fill="none"
            stroke="var(--accent)"
            stroke-width="4"
            stroke-linecap="round"
          />
        </svg>
      </h1>
      <p class="intro">持续分享有用的 <span class="marker">AI 干货教程</span> ～</p>
      <div class="hero-actions">
        <a href="#articles" class="sketch-btn primary">看看文章 📚</a>
        <a href="#projects" class="sketch-btn">逛逛项目 🚀</a>
      </div>
    </div>

    <div class="hero-doodle">
      <div class="hero-avatar">
        <Image src={avatar} alt="卡卡罗特AI 头像" width={260} height={260} densities={[1, 2]} />
      </div>

      <!-- 漂浮涂鸦 -->
      <svg class="floaty f1" viewBox="0 0 40 40" width="36" style="--r: 8deg" aria-hidden="true">
        <path d="M20 4 L24 16 L37 16 L27 24 L31 36 L20 28 L9 36 L13 24 L3 16 L16 16 Z" fill="#ffd65a" stroke="#2b2b2b" stroke-width="2" stroke-linejoin="round" />
      </svg>
      <svg class="floaty f2" viewBox="0 0 48 32" width="48" style="--r: -6deg" aria-hidden="true">
        <path d="M12 24 Q4 24 4 17 Q4 10 12 10 Q13 3 22 3 Q30 3 32 9 Q42 8 43 16 Q44 24 34 24 Z" fill="#fff" stroke="#2b2b2b" stroke-width="2.5" stroke-linejoin="round" />
      </svg>
      <svg class="floaty f3" viewBox="0 0 28 40" width="26" style="--r: 10deg" aria-hidden="true">
        <path d="M16 2 L6 22 L13 22 L10 38 L23 16 L15 16 L20 2 Z" fill="#ff6b35" stroke="#2b2b2b" stroke-width="2" stroke-linejoin="round" />
      </svg>
    </div>
  </section>

  <!-- ===== 项目 ===== -->
  <section id="projects" class="container section">
    <div class="section-head reveal">
      <h2 class="section-title">
        我的 Vibe-Coding 项目
        <svg class="doodle-star" viewBox="0 0 40 40" aria-hidden="true">
          <path d="M20 4 L24 16 L37 16 L27 24 L31 36 L20 28 L9 36 L13 24 L3 16 L16 16 Z" fill="#ffd65a" stroke="#2b2b2b" stroke-width="2" stroke-linejoin="round" />
        </svg>
      </h2>
      <p class="section-sub">灵感一来就动手，全是和 AI 结对撸出来的小玩意儿</p>
    </div>

    <div class="project-grid">
      {
        projects.map((p, i) => (
          <a
            href={p.url}
            target="_blank"
            rel="noopener noreferrer"
            class={`project-card sketch-box reveal ${i % 2 === 1 ? 'alt' : ''}`}
            style={`transition-delay: ${i * 80}ms`}
          >
            <span class="tape" aria-hidden="true" />
            <div class="project-emoji">{p.emoji}</div>
            <h3>{p.name}</h3>
            <p class="project-desc">{p.description}</p>
            <div class="project-foot">
              <span class={`badge ${p.color}`}>{p.tag}</span>
              <span class="go-arrow" aria-hidden="true">→</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ===== 公众号文章 ===== -->
  <section id="articles" class="container section">
    <div class="section-head reveal">
      <h2 class="section-title">
        博客文章
        <svg class="doodle-star" viewBox="0 0 40 40" aria-hidden="true">
          <path d="M20 4 L24 16 L37 16 L27 24 L31 36 L20 28 L9 36 L13 24 L3 16 L16 16 Z" fill="#ffb3c1" stroke="#2b2b2b" stroke-width="2" stroke-linejoin="round" />
        </svg>
      </h2>
      <p class="section-sub">主阵地在公众号，点开卡片直达原文</p>
    </div>

    <div class="article-grid">
      {
        wechatArticles.slice(0, 5).map((a, i) => (
          <a
            href={a.url}
            target="_blank"
            rel="noopener noreferrer"
            class={`article-card sketch-box reveal ${i % 2 === 1 ? 'alt' : ''}`}
            style={`transition-delay: ${i * 80}ms`}
          >
            <div class="article-cover">
              <img src={a.cover} alt={a.title} loading="lazy" />
            </div>
            <div class="article-body">
              <div class="article-meta">
                <span class="badge green">公众号</span>
                <time>{a.date}</time>
              </div>
              <h3>{a.title}</h3>
              <p>{a.description}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ===== 站内 Markdown 博客 ===== -->
  <section class="container section">
    <div class="backup-box sketch-box reveal">
      <div class="backup-head">
        <h2 class="section-title">站内备份文章 🗂️</h2>
        <p class="section-sub">公众号文章偶尔会失踪，重要干货这里都有 Markdown 备份，放心看</p>
      </div>
      <ul class="backup-list">
        {
          recentPosts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`}>
                <span class="backup-title">{post.data.title}</span>
                <time>{post.data.pubDate.toISOString().slice(0, 10)}</time>
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/blog/" class="sketch-btn">全部站内文章 →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    margin-top: 96px;
  }

  .section-head {
    margin-bottom: 36px;
  }

  .section-sub {
    opacity: 0.75;
    margin-top: 6px;
  }

  /* ===== Hero ===== */
  .hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    padding-top: 72px;
    min-height: 480px;
  }

  .hello {
    font-family: var(--font-hand);
    font-size: 1.3rem;
    opacity: 0.8;
    animation: bounce-in 0.7s ease both;
  }

  .name {
    font-size: clamp(2.6rem, 7vw, 4.2rem);
    font-weight: 900;
    line-height: 1.15;
    animation: bounce-in 0.7s ease both 0.15s;
  }

  .ai-badge {
    display: inline-block;
    background: var(--accent);
    color: #fff;
    font-size: 0.55em;
    padding: 0 16px;
    margin-left: 8px;
    border: 3px solid var(--ink);
    border-radius: var(--squiggle);
    transform: rotate(-4deg) translateY(-8px);
    box-shadow: 3px 4px 0 rgba(43, 43, 43, 0.85);
  }

  .intro {
    font-family: var(--font-hand);
    font-size: 1.35rem;
    margin-top: 18px;
    animation: bounce-in 0.7s ease both 0.3s;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    margin-top: 30px;
    animation: bounce-in 0.7s ease both 0.45s;
  }

  .hero-doodle {
    position: relative;
    flex-shrink: 0;
    animation: float 4s ease-in-out infinite;
  }

  .hero-avatar {
    width: 260px;
    height: 260px;
    border-radius: 50%;
    border: 4px solid var(--ink);
    box-shadow: 5px 6px 0 rgba(43, 43, 43, 0.85);
    transform: rotate(-2deg);
    overflow: hidden;
    background: var(--card-bg);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .hero-avatar:hover {
    transform: rotate(0deg) scale(1.03);
    box-shadow: 7px 9px 0 rgba(43, 43, 43, 0.85);
  }

  .hero-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .floaty {
    position: absolute;
    animation: float 3.4s ease-in-out infinite;
  }

  .f1 { top: -18px; left: -30px; animation-delay: 0.2s; }
  .f2 { top: 30px; right: -44px; animation-delay: 0.9s; }
  .f3 { bottom: 10px; left: -40px; animation-delay: 1.5s; }

  /* ===== 项目卡片 ===== */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 28px;
  }

  .project-card {
    position: relative;
    display: block;
    padding: 26px 22px 20px;
    text-decoration: none;
  }

  .project-card:hover {
    transform: translateY(-6px) rotate(-1.2deg);
    box-shadow: 7px 9px 0 rgba(43, 43, 43, 0.85);
  }

  .project-card:nth-child(even):hover {
    transform: translateY(-6px) rotate(1.2deg);
  }

  .tape {
    position: absolute;
    top: -12px;
    left: 50%;
    width: 84px;
    height: 24px;
    transform: translateX(-50%) rotate(-3deg);
    background: rgba(255, 214, 90, 0.75);
    border: 1.5px dashed rgba(43, 43, 43, 0.4);
  }

  .project-emoji {
    font-size: 2.4rem;
    line-height: 1;
    margin-bottom: 12px;
    transition: transform 0.25s ease;
  }

  .project-card:hover .project-emoji {
    transform: scale(1.25) rotate(-8deg);
  }

  .project-card h3 {
    font-size: 1.2rem;
    margin-bottom: 8px;
  }

  .project-desc {
    font-size: 0.95rem;
    opacity: 0.8;
    min-height: 3.4em;
  }

  .project-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 14px;
  }

  .go-arrow {
    font-size: 1.3rem;
    font-weight: 900;
    transition: transform 0.2s ease;
  }

  .project-card:hover .go-arrow {
    transform: translateX(6px);
    color: var(--accent);
  }

  /* ===== 文章卡片（横向长方形：左封面，右标题/描述） ===== */
  .article-grid {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .article-card {
    display: flex;
    align-items: stretch;
    text-decoration: none;
    overflow: hidden;
  }

  .article-card:hover {
    transform: translateY(-6px) rotate(-0.8deg);
    box-shadow: 7px 9px 0 rgba(43, 43, 43, 0.85);
  }

  .article-cover {
    flex-shrink: 0;
    width: 240px;
    border-right: 2.5px solid var(--ink);
    overflow: hidden;
  }

  .article-cover img {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .article-card:hover .article-cover img {
    transform: scale(1.05) rotate(0.5deg);
  }

  .article-body {
    flex: 1;
    padding: 18px 20px 22px;
  }

  .article-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
    font-size: 0.85rem;
    opacity: 0.9;
  }

  .article-body h3 {
    font-size: 1.15rem;
    margin-bottom: 8px;
    line-height: 1.45;
  }

  .article-body p {
    font-size: 0.95rem;
    opacity: 0.8;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ===== 站内备份 ===== */
  .backup-box {
    padding: 36px 40px;
  }

  .backup-head {
    margin-bottom: 20px;
  }

  .backup-list {
    list-style: none;
    margin-bottom: 26px;
  }

  .backup-list li a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 4px;
    text-decoration: none;
    border-bottom: 2px dashed rgba(43, 43, 43, 0.3);
    transition: background 0.2s ease, padding-left 0.2s ease;
  }

  .backup-list li a:hover {
    background: var(--highlight);
    padding-left: 12px;
  }

  .backup-title {
    font-weight: 700;
    font-size: 1.05rem;
  }

  .backup-list time {
    flex-shrink: 0;
    font-size: 0.88rem;
    opacity: 0.65;
  }

  @media (max-width: 800px) {
    .hero {
      flex-direction: column-reverse;
      text-align: center;
      padding-top: 40px;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-avatar {
      width: 200px;
      height: 200px;
    }

    .article-card {
      flex-direction: column;
    }

    .article-cover {
      width: 100%;
      border-right: none;
      border-bottom: 2.5px solid var(--ink);
    }

    .backup-box {
      padding: 26px 22px;
    }
  }
</style>
