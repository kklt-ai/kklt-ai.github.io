---
import type { GetStaticPathsOptions, Page } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllArticles, type Article } from '../../data/articles';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const articles = await getAllArticles();
  return paginate(articles, { pageSize: 6 });
}

interface Props {
  page: Page<Article>;
}

const { page } = Astro.props;
---

<BaseLayout title="全部文章 · 卡卡罗特AI">
  <section class="container blog-index">
    <div class="page-head reveal visible">
      <h1 class="section-title">
        全部文章
        <svg class="doodle-star" viewBox="0 0 40 40" aria-hidden="true">
          <path d="M20 4 L24 16 L37 16 L27 24 L31 36 L20 28 L9 36 L13 24 L3 16 L16 16 Z" fill="#a5d8ff" stroke="#2b2b2b" stroke-width="2" stroke-linejoin="round" />
        </svg>
      </h1>
      <a href="/blog/tag/" class="tags-link">按标签浏览 →</a>
    </div>

    <div class="article-grid">
      {
        page.data.map((a, i) => (
          <a
            href={a.url}
            target={a.external ? '_blank' : undefined}
            rel={a.external ? 'noopener noreferrer' : undefined}
            class={`article-card sketch-box reveal ${i % 2 === 1 ? 'alt' : ''}`}
            style={`transition-delay: ${i * 70}ms`}
          >
            {a.cover && (
              <div class="article-cover">
                <img src={a.cover} alt={a.title} loading="lazy" />
              </div>
            )}
            <div class="article-body">
              <div class="article-meta">
                <span class={`badge ${a.source === '公众号' ? 'green' : 'blue'}`}>{a.source}</span>
                <time>{a.date}</time>
              </div>
              <h3>{a.title}</h3>
              <p>{a.description}</p>
            </div>
          </a>
        ))
      }
    </div>

    {
      page.lastPage > 1 && (
        <nav class="pagination" aria-label="文章分页">
          {page.url.prev ? (
            <a href={page.url.prev} class="sketch-btn">← 上一页</a>
          ) : (
            <span class="sketch-btn disabled" aria-disabled="true">← 上一页</span>
          )}
          <span class="page-info">第 {page.currentPage} / {page.lastPage} 页</span>
          {page.url.next ? (
            <a href={page.url.next} class="sketch-btn">下一页 →</a>
          ) : (
            <span class="sketch-btn disabled" aria-disabled="true">下一页 →</span>
          )}
        </nav>
      )
    }
  </section>
</BaseLayout>

<style>
  .blog-index {
    padding-top: 56px;
  }

  .page-head {
    margin-bottom: 40px;
  }

  .tags-link {
    display: inline-block;
    margin-top: 10px;
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--accent);
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .tags-link:hover {
    transform: translateX(4px);
  }

  /* ===== 文章卡片（与首页一致：左封面，右标题/描述） ===== */
  .article-grid {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .article-card {
    display: flex;
    align-items: stretch;
    text-decoration: none;
    overflow: hidden;
  }

  .article-card:hover {
    transform: translateY(-6px) rotate(-0.8deg);
    box-shadow: 7px 9px 0 rgba(43, 43, 43, 0.85);
  }

  .article-cover {
    flex-shrink: 0;
    width: 320px;
    border-right: 2.5px solid var(--ink);
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .article-cover img {
    width: 100%;
    height: auto;
    aspect-ratio: 2.35 / 1;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .article-card:hover .article-cover img {
    transform: scale(1.05) rotate(0.5deg);
  }

  .article-body {
    flex: 1;
    padding: 18px 20px 22px;
  }

  .article-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
    font-size: 0.85rem;
    opacity: 0.9;
  }

  .article-body h3 {
    font-size: 1.15rem;
    margin-bottom: 8px;
    line-height: 1.45;
  }

  .article-body p {
    font-size: 0.95rem;
    opacity: 0.8;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ===== 分页 ===== */
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 22px;
    margin-top: 48px;
  }

  .page-info {
    font-family: var(--font-hand);
    font-weight: 700;
  }

  .sketch-btn.disabled {
    opacity: 0.4;
    pointer-events: none;
  }

  @media (max-width: 800px) {
    .article-card {
      flex-direction: column;
    }

    .article-cover {
      width: 100%;
      border-right: none;
      border-bottom: 2.5px solid var(--ink);
    }
  }
</style>
