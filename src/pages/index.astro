---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFeaturedProjects } from '../data/projects';
import { getAllArticles } from '../data/articles';
import { getLatestVideos } from '../data/videos';
import avatar from '../assets/avatar.jpg';

const featuredProjects = getFeaturedProjects(3);
const articles = (await getAllArticles()).slice(0, 5);
const videos = getLatestVideos(3);

// 精选项目的手绘风 SVG 图标，按项目名匹配；没有配置时回退为 emoji
const projectIcons: Record<string, string> = {
  公众号排版助手: `<svg viewBox="0 0 24 24" fill="none" stroke="#2b2b2b" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3.8 Q6 3 6.8 3 H13.4 L18 7.6 V20 Q18 20.8 17.2 20.8 H6.8 Q6 20.8 6 20 Z" fill="#fff"/><path d="M13.2 3.2 V7.8 H18"/><path d="M8.8 11.5 H15.2"/><path d="M8.8 14.3 H13.6"/><path d="M8.6 17.4 H15.4" stroke="#ff6b35" stroke-width="2.6"/></svg>`,
  手写图片生成器: `<svg viewBox="0 0 24 24" fill="none" stroke="#2b2b2b" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.2" y="4.2" width="17.6" height="15.6" rx="2.2" fill="#fff"/><path d="M6.2 15.5 Q8 10 9.8 13 Q11.6 16 13.2 11.5"/><path d="M15.2 13.8 L19.4 6.4 L20.6 7.6 L16.4 15 L14.9 15.3 Z" fill="#ffd65a"/></svg>`,
};
---

<BaseLayout title="卡卡罗特AI · 手绘博客">
  <!-- ===== Hero ===== -->
  <section class="hero container">
    <div class="hero-text">
      <p class="hello">你好，我是</p>
      <h1 class="name">
        卡卡罗特<span class="ai-badge">AI</span>
        <svg class="squiggle-underline" viewBox="0 0 220 14" aria-hidden="true">
          <path
            d="M4 8 Q20 2 36 8 T68 8 T100 8 T132 8 T164 8 T196 8 T216 8"
            fill="none"
            stroke="var(--accent)"
            stroke-width="4"
            stroke-linecap="round"
          />
        </svg>
      </h1>
      <p class="intro">持续分享有用的 <span class="marker">AI 干货教程</span> ～</p>
      <div class="hero-actions">
        <a href="#articles" class="sketch-btn primary">看看文章 📚</a>
        <a href="#projects" class="sketch-btn">逛逛项目 🚀</a>
        <div class="wechat-follow">
          <button
            type="button"
            class="sketch-btn wechat-trigger"
            aria-expanded="false"
            aria-controls="wechat-qr-popover"
          >
            关注公众号
          </button>
          <div id="wechat-qr-popover" class="wechat-popover sketch-box" role="tooltip">
            <span class="wechat-tape" aria-hidden="true" />
            <img
              src="/wechat_qrcode.JPG"
              alt="卡卡罗特AI 微信公众号二维码"
              width="200"
              height="222"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </div>

    <div class="hero-doodle">
      <div class="hero-avatar">
        <Image src={avatar} alt="卡卡罗特AI 头像" width={260} height={260} densities={[1, 2]} />
      </div>

      <!-- 漂浮涂鸦 -->
      <svg class="floaty f1" viewBox="0 0 40 40" width="36" style="--r: 8deg" aria-hidden="true">
        <path d="M20 4 L24 16 L37 16 L27 24 L31 36 L20 28 L9 36 L13 24 L3 16 L16 16 Z" fill="#ffd65a" stroke="#2b2b2b" stroke-width="2" stroke-linejoin="round" />
      </svg>
      <svg class="floaty f2" viewBox="0 0 48 32" width="48" style="--r: -6deg" aria-hidden="true">
        <path d="M12 24 Q4 24 4 17 Q4 10 12 10 Q13 3 22 3 Q30 3 32 9 Q42 8 43 16 Q44 24 34 24 Z" fill="#fff" stroke="#2b2b2b" stroke-width="2.5" stroke-linejoin="round" />
      </svg>
      <svg class="floaty f3" viewBox="0 0 28 40" width="26" style="--r: 10deg" aria-hidden="true">
        <path d="M16 2 L6 22 L13 22 L10 38 L23 16 L15 16 L20 2 Z" fill="#ff6b35" stroke="#2b2b2b" stroke-width="2" stroke-linejoin="round" />
      </svg>
    </div>
  </section>

  <!-- ===== Vibe Coding 精选 ===== -->
  <section id="projects" class="container section">
    <div class="section-head reveal">
      <h2 class="section-title">
        Vibe Coding精选
        <svg class="doodle-star" viewBox="0 0 40 40" aria-hidden="true">
          <path d="M20 4 L24 16 L37 16 L27 24 L31 36 L20 28 L9 36 L13 24 L3 16 L16 16 Z" fill="#ffd65a" stroke="#2b2b2b" stroke-width="2" stroke-linejoin="round" />
        </svg>
      </h2>
    </div>

    <div class="project-spotlight">
      {
        featuredProjects.map((p, i) => (
          <a
            href={p.url}
            target="_blank"
            rel="noopener noreferrer"
            class={`project-card sketch-box reveal ${i % 2 === 1 ? 'alt' : ''}`}
            style={`transition-delay: ${i * 80}ms`}
          >
            <span class="tape" aria-hidden="true" />
            {p.needVpn && <span class="vpn-tag">需要魔法</span>}
            <div class="project-head">
              <span class="project-icon" set:html={projectIcons[p.name] ?? p.emoji} />
              <h3>{p.name}</h3>
            </div>
            <p class="project-desc">{p.description}</p>
            <div class="project-foot">
              <span class={`badge ${p.color}`}>{p.tag}</span>
              <span class="go-arrow" aria-hidden="true">→</span>
            </div>
          </a>
        ))
      }
    </div>

    <div class="section-more reveal">
      <a href="/projects/" class="sketch-btn">全部 Vibe-Coding 项目 →</a>
    </div>
  </section>

  <!-- ===== 文章 ===== -->
  <section id="articles" class="container section">
    <div class="section-head reveal">
      <h2 class="section-title">
        最新文章
        <svg class="doodle-star" viewBox="0 0 40 40" aria-hidden="true">
          <path d="M20 4 L24 16 L37 16 L27 24 L31 36 L20 28 L9 36 L13 24 L3 16 L16 16 Z" fill="#ffb3c1" stroke="#2b2b2b" stroke-width="2" stroke-linejoin="round" />
        </svg>
      </h2>
    </div>

    <div class="article-grid">
      {
        articles.map((a, i) => (
          <a
            href={a.url}
            target={a.external ? '_blank' : undefined}
            rel={a.external ? 'noopener noreferrer' : undefined}
            class={`article-card sketch-box reveal ${i % 2 === 1 ? 'alt' : ''}`}
            style={`transition-delay: ${i * 80}ms`}
          >
            {a.cover && (
              <div class="article-cover">
                <img src={a.cover} alt={a.title} loading="lazy" />
              </div>
            )}
            <div class="article-body">
              <div class="article-meta">
                <span class="meta-badges">
                  {a.pinned && <span class="badge orange">置顶</span>}
                  <span class={`badge ${a.source === '公众号' ? 'green' : 'blue'}`}>{a.source}</span>
                </span>
                <time>{a.date}</time>
              </div>
              <h3>{a.title}</h3>
              <p>{a.description}</p>
            </div>
          </a>
        ))
      }
    </div>

    <div class="section-more reveal">
      <a href="/blog/" class="sketch-btn primary">查看全部文章 →</a>
    </div>
  </section>

  <!-- ===== 视频教程 ===== -->
  {
    videos.length > 0 && (
      <section id="videos" class="container section">
        <div class="section-head reveal">
          <h2 class="section-title">
            视频教程
            <svg class="doodle-star" viewBox="0 0 40 40" aria-hidden="true">
              <path d="M20 4 L24 16 L37 16 L27 24 L31 36 L20 28 L9 36 L13 24 L3 16 L16 16 Z" fill="#a5d8ff" stroke="#2b2b2b" stroke-width="2" stroke-linejoin="round" />
            </svg>
          </h2>
        </div>

        <div class="video-grid">
          {videos.map((v, i) => (
            <a
              href={v.url}
              target="_blank"
              rel="noopener noreferrer"
              class={`video-card sketch-box reveal ${i % 2 === 1 ? 'alt' : ''}`}
              style={`transition-delay: ${i * 80}ms`}
            >
              <div class="video-cover">
                <img src={v.cover} alt={v.title} loading="lazy" />
                <span class="play-badge" aria-hidden="true">▶</span>
              </div>
              <div class="video-body">
                <time>{v.date}</time>
                <h3>{v.title}</h3>
                <div class="video-foot">
                  <span class="badge pink">B站</span>
                  <span class="go-arrow" aria-hidden="true">→</span>
                </div>
              </div>
            </a>
          ))}
        </div>

        <div class="section-more reveal">
          <a href="/videos/" class="sketch-btn">查看全部视频 →</a>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .section {
    margin-top: 96px;
  }

  .section-head {
    margin-bottom: 36px;
  }

  /* ===== Hero ===== */
  .hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    padding-top: 72px;
    min-height: 480px;
  }

  .hello {
    font-family: var(--font-hand);
    font-size: 1.3rem;
    opacity: 0.8;
    animation: bounce-in 0.7s ease both;
  }

  .name {
    font-size: clamp(2.6rem, 7vw, 4.2rem);
    font-weight: 900;
    line-height: 1.15;
    animation: bounce-in 0.7s ease both 0.15s;
  }

  .ai-badge {
    display: inline-block;
    background: var(--accent);
    color: #fff;
    font-size: 0.55em;
    padding: 0 16px;
    margin-left: 8px;
    border: 3px solid var(--ink);
    border-radius: var(--squiggle);
    transform: rotate(-4deg) translateY(-8px);
    box-shadow: 3px 4px 0 rgba(43, 43, 43, 0.85);
  }

  .intro {
    font-family: var(--font-hand);
    font-size: 1.35rem;
    margin-top: 18px;
    animation: bounce-in 0.7s ease both 0.3s;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 30px;
    animation: bounce-in 0.7s ease both 0.45s;
  }

  /* 公众号：悬停/点击弹出便签二维码 */
  .wechat-follow {
    position: relative;
    display: inline-block;
  }

  .wechat-popover {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 16px);
    z-index: 30;
    width: 220px;
    padding: 14px 14px 10px;
    background: #fff;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateX(-50%) translateY(10px) rotate(-2deg);
    transition:
      opacity 0.2s ease,
      transform 0.25s ease,
      visibility 0.2s ease;
  }

  .wechat-follow.is-open .wechat-popover {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0) rotate(-2deg);
  }

  @media (hover: hover) and (pointer: fine) {
    .wechat-follow:hover .wechat-popover,
    .wechat-follow:focus-within .wechat-popover {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateX(-50%) translateY(0) rotate(-2deg);
    }
  }

  .wechat-popover::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -8px;
    width: 14px;
    height: 14px;
    background: #fff;
    border-right: 2.5px solid var(--ink);
    border-bottom: 2.5px solid var(--ink);
    transform: translateX(-50%) rotate(45deg);
  }

  .wechat-tape {
    position: absolute;
    top: -10px;
    left: 50%;
    width: 72px;
    height: 20px;
    transform: translateX(-50%) rotate(-4deg);
    background: rgba(165, 216, 255, 0.85);
    border: 1.5px dashed rgba(43, 43, 43, 0.4);
  }

  .wechat-popover img {
    width: 100%;
    height: auto;
    border-radius: 4px;
  }

  .hero-doodle {
    position: relative;
    flex-shrink: 0;
    animation: float 4s ease-in-out infinite;
  }

  .hero-avatar {
    width: 260px;
    height: 260px;
    border-radius: 50%;
    border: 4px solid var(--ink);
    box-shadow: 5px 6px 0 rgba(43, 43, 43, 0.85);
    transform: rotate(-2deg);
    overflow: hidden;
    background: var(--card-bg);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .hero-avatar:hover {
    transform: rotate(0deg) scale(1.03);
    box-shadow: 7px 9px 0 rgba(43, 43, 43, 0.85);
  }

  .hero-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .floaty {
    position: absolute;
    animation: float 3.4s ease-in-out infinite;
  }

  .f1 { top: -18px; left: -30px; animation-delay: 0.2s; }
  .f2 { top: 30px; right: -44px; animation-delay: 0.9s; }
  .f3 { bottom: 10px; left: -40px; animation-delay: 1.5s; }

  /* ===== Vibe Coding 精选：按项目数量自适应并居中 ===== */
  .project-spotlight {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 360px));
    justify-content: center;
    gap: 28px;
  }

  .project-card {
    position: relative;
    display: block;
    padding: 22px 20px 18px;
    text-decoration: none;
  }

  .project-card:hover {
    transform: translateY(-6px) rotate(-1.2deg);
    box-shadow: 7px 9px 0 rgba(43, 43, 43, 0.85);
  }

  .project-card:nth-child(even):hover {
    transform: translateY(-6px) rotate(1.2deg);
  }

  .tape {
    position: absolute;
    top: -10px;
    left: 50%;
    width: 64px;
    height: 18px;
    transform: translateX(-50%) rotate(-3deg);
    background: rgba(255, 214, 90, 0.75);
    border: 1.5px dashed rgba(43, 43, 43, 0.4);
  }

  .project-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }

  .project-icon {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    background: #fff;
    border: 2.5px solid var(--ink);
    border-radius: var(--squiggle);
    transform: rotate(-3deg);
    box-shadow: 2px 3px 0 rgba(43, 43, 43, 0.85);
    font-size: 1.4rem;
    line-height: 1;
    transition: transform 0.25s ease;
  }

  .project-icon svg {
    width: 26px;
    height: 26px;
  }

  .project-card:hover .project-icon {
    transform: rotate(3deg) scale(1.08);
  }

  .project-card h3 {
    font-size: 1.2rem;
  }

  .project-desc {
    font-size: 0.95rem;
    opacity: 0.8;
  }

  .project-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 14px;
  }

  .vpn-tag {
    position: absolute;
    top: 14px;
    right: 14px;
    font-size: 0.78rem;
    font-weight: 800;
    padding: 3px 9px;
    background: var(--accent);
    color: #fff;
    border: 1.5px solid var(--ink);
    border-radius: 6px;
    transform: rotate(6deg);
  }

  .go-arrow {
    font-size: 1.3rem;
    font-weight: 900;
    transition: transform 0.2s ease;
  }

  .project-card:hover .go-arrow {
    transform: translateX(6px);
    color: var(--accent);
  }

  /* ===== 文章卡片（横向长方形：左封面，右标题/描述） ===== */
  .article-grid {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .article-card {
    display: flex;
    align-items: stretch;
    text-decoration: none;
    overflow: hidden;
  }

  .article-card:hover {
    transform: translateY(-6px) rotate(-0.8deg);
    box-shadow: 7px 9px 0 rgba(43, 43, 43, 0.85);
  }

  .article-cover {
    flex-shrink: 0;
    width: 320px;
    border-right: 2.5px solid var(--ink);
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .article-cover img {
    width: 100%;
    height: auto;
    aspect-ratio: 2.35 / 1;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .article-card:hover .article-cover img {
    transform: scale(1.05) rotate(0.5deg);
  }

  .article-body {
    flex: 1;
    padding: 18px 20px 22px;
  }

  .article-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
    font-size: 0.85rem;
    opacity: 0.9;
  }

  .meta-badges {
    display: flex;
    gap: 6px;
  }

  .article-body h3 {
    font-size: 1.15rem;
    margin-bottom: 8px;
    line-height: 1.45;
  }

  .article-body p {
    font-size: 0.95rem;
    opacity: 0.8;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ===== 全部文章入口 ===== */
  .section-more {
    margin-top: 36px;
    text-align: center;
  }

  /* ===== 视频卡片（封面在上，标题/日期在下） ===== */
  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 28px;
  }

  .video-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    overflow: hidden;
  }

  .video-card:hover {
    transform: translateY(-6px) rotate(-1deg);
    box-shadow: 7px 9px 0 rgba(43, 43, 43, 0.85);
  }

  .video-card:nth-child(even):hover {
    transform: translateY(-6px) rotate(1deg);
  }

  .video-cover {
    position: relative;
    border-bottom: 2.5px solid var(--ink);
    overflow: hidden;
  }

  .video-cover img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .video-card:hover .video-cover img {
    transform: scale(1.05);
  }

  .play-badge {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    background: rgba(255, 214, 90, 0.92);
    border: 2px solid var(--ink);
    border-radius: 50%;
    font-size: 0.95rem;
    transition: transform 0.2s ease;
  }

  .video-card:hover .play-badge {
    transform: scale(1.15) rotate(-8deg);
  }

  .video-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 16px 18px 18px;
  }

  .video-body time {
    font-size: 0.85rem;
    opacity: 0.7;
  }

  .video-body h3 {
    font-size: 1.05rem;
    margin-top: 6px;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .video-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 14px;
  }

  @media (max-width: 800px) {
    .hero {
      flex-direction: column-reverse;
      text-align: center;
      padding-top: 40px;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-avatar {
      width: 200px;
      height: 200px;
    }

    .article-card {
      flex-direction: column;
    }

    .article-cover {
      width: 100%;
      border-right: none;
      border-bottom: 2.5px solid var(--ink);
    }
  }
</style>

<script>
  const follow = document.querySelector('.wechat-follow');
  const trigger = follow?.querySelector('.wechat-trigger');

  if (follow && trigger instanceof HTMLButtonElement) {
    const canHover = () => window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    trigger.addEventListener('click', (event) => {
      if (canHover()) return;
      event.stopPropagation();
      const open = follow.classList.toggle('is-open');
      trigger.setAttribute('aria-expanded', String(open));
    });

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Node) || follow.contains(event.target)) return;
      follow.classList.remove('is-open');
      trigger.setAttribute('aria-expanded', 'false');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      follow.classList.remove('is-open');
      trigger.setAttribute('aria-expanded', 'false');
    });
  }
</script>
