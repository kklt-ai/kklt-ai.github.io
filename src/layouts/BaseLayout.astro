---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '卡卡罗特AI · 持续分享有用的AI干货教程～' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="container nav-inner">
        <a href="/" class="logo" aria-label="回到首页">
          <span>卡卡罗特AI</span>
        </a>
        <div class="nav-links">
          <a href="/projects/">项目</a>
          <a href="/blog/">文章</a>
        </div>
      </nav>
      <svg class="header-squiggle" viewBox="0 0 1200 12" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 6 Q30 0 60 6 T120 6 T180 6 T240 6 T300 6 T360 6 T420 6 T480 6 T540 6 T600 6 T660 6 T720 6 T780 6 T840 6 T900 6 T960 6 T1020 6 T1080 6 T1140 6 T1200 6" fill="none" stroke="#2b2b2b" stroke-width="2.5" />
      </svg>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <svg class="footer-squiggle" viewBox="0 0 1200 12" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 6 Q30 0 60 6 T120 6 T180 6 T240 6 T300 6 T360 6 T420 6 T480 6 T540 6 T600 6 T660 6 T720 6 T780 6 T840 6 T900 6 T960 6 T1020 6 T1080 6 T1140 6 T1200 6" fill="none" stroke="#2b2b2b" stroke-width="2.5" />
      </svg>
      <div class="container footer-inner">
        <p>© {new Date().getFullYear()} 卡卡罗特AI · 持续分享有用的AI干货教程～</p>
      </div>
    </footer>

    <script>
      // 滚动渐入动画
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: var(--paper);
      }

      .nav-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 14px;
        padding-bottom: 10px;
      }

      .logo {
        display: flex;
        align-items: center;
        font-size: 1.35rem;
        font-weight: 900;
        text-decoration: none;
      }

      .nav-links {
        display: flex;
        gap: 26px;
      }

      .nav-links a {
        font-family: var(--font-hand);
        text-decoration: none;
        font-weight: 700;
        position: relative;
        padding: 2px 4px;
      }

      .nav-links a::after {
        content: '';
        position: absolute;
        left: 0;
        right: 100%;
        bottom: -2px;
        height: 3px;
        background: var(--accent);
        border-radius: 3px;
        transition: right 0.25s ease;
      }

      .nav-links a:hover::after {
        right: 0;
      }

      .header-squiggle,
      .footer-squiggle {
        display: block;
        width: 100%;
        height: 12px;
      }

      .site-footer {
        margin-top: 90px;
        text-align: center;
      }

      .footer-inner {
        padding: 28px 24px 40px;
        opacity: 0.85;
      }

      @media (max-width: 560px) {
        .nav-links {
          gap: 14px;
          font-size: 0.95rem;
        }
      }
    </style>
  </body>
</html>
