---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareButton from '../../components/ShareButton.astro';
import { getToolsByCategory } from '../../data/tools';

const groups = getToolsByCategory();
---

<BaseLayout title="工具导航 · 卡卡罗特AI" description="卡卡罗特AI 私藏的宝藏网站导航，按功能分类，个个都是效率神器">
  <section class="container tools-index">
    <div class="page-head reveal visible">
      <h1 class="section-title">
        工具导航
        <svg class="doodle-star" viewBox="0 0 40 40" aria-hidden="true">
          <path d="M20 4 L24 16 L37 16 L27 24 L31 36 L20 28 L9 36 L13 24 L3 16 L16 16 Z" fill="#dcedc8" stroke="#2b2b2b" stroke-width="2" stroke-linejoin="round" />
        </svg>
      </h1>
      <p class="page-desc">私藏的宝藏网站，按功能分类整理，个个都是效率神器 ✨</p>
      <ShareButton title="工具导航 · 卡卡罗特AI" />
    </div>

    {
      groups.map((group) => (
        <section class="tool-group">
          <h2 class="group-title">
            <span class="marker">{group.category}</span>
          </h2>
          <div class="tool-grid">
            {group.sites.map((site, i) => (
              <a
                href={`/tools/${site.slug}/`}
                class={`tool-card sketch-box reveal ${i % 2 === 1 ? 'alt' : ''}`}
                style={`transition-delay: ${i * 70}ms`}
              >
                <span class="tape" aria-hidden="true" />
                <div class="tool-emoji" set:html={site.icon ?? site.emoji} />
                <h3>{site.name}</h3>
                <p class="tool-desc">{site.description}</p>
                <div class="tool-foot">
                  <span class={`badge ${site.color}`}>{site.category}</span>
                  <span class="go-arrow" aria-hidden="true">→</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </section>
</BaseLayout>

<style>
  .tools-index {
    padding-top: 56px;
    padding-bottom: 40px;
  }

  .page-head {
    margin-bottom: 20px;
  }

  .page-desc {
    opacity: 0.8;
    margin-top: 6px;
  }

  .page-head :global(.share-btn) {
    margin-top: 10px;
  }

  .tool-group {
    margin-top: 44px;
  }

  .group-title {
    font-size: 1.4rem;
    font-weight: 900;
    margin-bottom: 24px;
  }

  .tool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 28px;
  }

  .tool-card {
    position: relative;
    display: block;
    padding: 26px 22px 20px;
    text-decoration: none;
  }

  .tool-card:hover {
    transform: translateY(-6px) rotate(-1.2deg);
    box-shadow: 7px 9px 0 rgba(43, 43, 43, 0.85);
  }

  .tool-card:nth-child(even):hover {
    transform: translateY(-6px) rotate(1.2deg);
  }

  .tape {
    position: absolute;
    top: -12px;
    left: 50%;
    width: 84px;
    height: 24px;
    transform: translateX(-50%) rotate(-3deg);
    background: rgba(255, 214, 90, 0.75);
    border: 1.5px dashed rgba(43, 43, 43, 0.4);
  }

  .tool-emoji {
    font-size: 2.4rem;
    line-height: 1;
    margin-bottom: 12px;
    transition: transform 0.25s ease;
  }

  .tool-emoji svg {
    width: 2.6rem;
    height: 2.6rem;
    display: block;
  }

  .tool-card:hover .tool-emoji {
    transform: scale(1.25) rotate(-8deg);
  }

  .tool-card h3 {
    font-size: 1.2rem;
    margin-bottom: 8px;
  }

  .tool-desc {
    font-size: 0.95rem;
    opacity: 0.8;
    min-height: 3.4em;
  }

  .tool-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 14px;
  }

  .go-arrow {
    font-size: 1.3rem;
    font-weight: 900;
    transition: transform 0.2s ease;
  }

  .tool-card:hover .go-arrow {
    transform: translateX(6px);
    color: var(--accent);
  }
</style>
