---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ShareButton from '../../../components/ShareButton.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter((post) => post.data.tags.includes(tag))
        .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()),
    },
  }));
}

interface Props {
  tag: string;
  posts: CollectionEntry<'blog'>[];
}

const { tag, posts } = Astro.props;
---

<BaseLayout
  title={`#${tag} 标签文章 · 卡卡罗特AI`}
  description={`浏览卡卡罗特AI 中所有带有“${tag}”标签的文章。`}
>
  <section class="container tag-index">
    <a href="/blog/" class="back-link">← 返回全部文章</a>

    <div class="page-head reveal visible">
      <h1 class="section-title"># {tag}</h1>
      <p>共 {posts.length} 篇文章</p>
      <ShareButton title={`#${tag} 标签文章 · 卡卡罗特AI`} />
    </div>

    <div class="article-grid">
      {
        posts.map((post, i) => (
          <a
            href={`/blog/${post.id}/`}
            class={`article-card sketch-box reveal ${i % 2 === 1 ? 'alt' : ''}`}
            style={`transition-delay: ${i * 70}ms`}
          >
            {post.data.cover && (
              <div class="article-cover">
                <img src={post.data.cover} alt={post.data.title} loading="lazy" />
              </div>
            )}
            <div class="article-body">
              <div class="article-meta">
                <span class="badge blue">站内</span>
                <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
                  {post.data.pubDate.toISOString().slice(0, 10)}
                </time>
              </div>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .tag-index {
    padding-top: 56px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 28px;
    font-size: 0.95rem;
    font-weight: 700;
    color: rgba(43, 43, 43, 0.65);
    text-decoration: none;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .back-link:hover {
    color: var(--ink);
    transform: translateX(-3px);
  }

  .page-head {
    margin-bottom: 40px;
  }

  .page-head p {
    margin-top: 6px;
    color: rgba(43, 43, 43, 0.65);
    font-size: 0.95rem;
  }

  .page-head :global(.share-btn) {
    margin-top: 12px;
  }

  .article-grid {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .article-card {
    display: flex;
    align-items: stretch;
    text-decoration: none;
    overflow: hidden;
  }

  .article-card:hover {
    transform: translateY(-6px) rotate(-0.8deg);
    box-shadow: 7px 9px 0 rgba(43, 43, 43, 0.85);
  }

  .article-cover {
    flex-shrink: 0;
    width: 240px;
    border-right: 2.5px solid var(--ink);
    overflow: hidden;
  }

  .article-cover img {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .article-card:hover .article-cover img {
    transform: scale(1.05) rotate(0.5deg);
  }

  .article-body {
    flex: 1;
    padding: 18px 20px 22px;
  }

  .article-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
    font-size: 0.85rem;
    opacity: 0.9;
  }

  .article-body h2 {
    margin-bottom: 8px;
    font-size: 1.15rem;
    line-height: 1.45;
  }

  .article-body p {
    display: -webkit-box;
    overflow: hidden;
    font-size: 0.95rem;
    opacity: 0.8;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  @media (max-width: 800px) {
    .article-card {
      flex-direction: column;
    }

    .article-cover {
      width: 100%;
      border-right: none;
      border-bottom: 2.5px solid var(--ink);
    }
  }
</style>
