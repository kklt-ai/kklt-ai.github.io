---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = '卡卡罗特AI · 持续分享有用的AI干货教程～', image } = Astro.props;

// 移动端分享卡片（微信/微博等）读取 og 标签；og:image 需绝对 URL 且不支持 SVG
const ogImagePath = image && !image.endsWith('.svg') ? image : '/og-default.png';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImagePath, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="卡卡罗特AI" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="container nav-inner">
        <div class="nav-top">
          <a href="/" class="logo" aria-label="回到首页">
            <span>卡卡罗特AI</span>
          </a>
          <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-more" aria-label="打开更多菜单">
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>
        <div class="nav-links">
          <a href="/projects/">项目</a>
          <a href="/blog/">文章</a>
          <a href="/videos/">视频</a>
          <a href="/tools/">工具</a>
          <div class="nav-more" id="nav-more">
            <a href="/about/">关于我</a>
            <a href="https://pay.ldxp.cn/shop/6688" target="_blank" rel="noopener noreferrer" class="nav-topup">GPT代充</a>
            <a href="https://github.com/kklt-ai" target="_blank" rel="noopener noreferrer" class="nav-github" aria-label="访问 GitHub 主页">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="nav-github-icon">
                <path
                  d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.15c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.69 1.25 3.35.95.1-.74.4-1.25.72-1.53-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11.1 11.1 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.35.77 1.05.77 2.12v3.14c0 .3.21.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
                  fill="currentColor"
                />
              </svg>
              GitHub
            </a>
          </div>
        </div>
      </nav>
      <svg class="header-squiggle" viewBox="0 0 1200 12" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 6 Q30 0 60 6 T120 6 T180 6 T240 6 T300 6 T360 6 T420 6 T480 6 T540 6 T600 6 T660 6 T720 6 T780 6 T840 6 T900 6 T960 6 T1020 6 T1080 6 T1140 6 T1200 6" fill="none" stroke="#2b2b2b" stroke-width="2.5" />
      </svg>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <svg class="footer-squiggle" viewBox="0 0 1200 12" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 6 Q30 0 60 6 T120 6 T180 6 T240 6 T300 6 T360 6 T420 6 T480 6 T540 6 T600 6 T660 6 T720 6 T780 6 T840 6 T900 6 T960 6 T1020 6 T1080 6 T1140 6 T1200 6" fill="none" stroke="#2b2b2b" stroke-width="2.5" />
      </svg>
      <div class="container footer-inner">
        <a
          href="https://github.com/kklt-ai"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-github"
          aria-label="访问 GitHub 主页"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" class="footer-github-icon">
            <path
              d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.15c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.69 1.25 3.35.95.1-.74.4-1.25.72-1.53-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11.1 11.1 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.35.77 1.05.77 2.12v3.14c0 .3.21.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
              fill="currentColor"
            />
          </svg>
          GitHub
        </a>
        <p>© {new Date().getFullYear()} 卡卡罗特AI · 持续分享有用的AI干货教程～</p>
      </div>
    </footer>

    <script>
      // 移动端汉堡菜单：展开/收起「更多」面板
      const navToggle = document.querySelector('.nav-toggle');
      const navMore = document.querySelector('.nav-more');
      if (navToggle && navMore) {
        const setOpen = (open) => {
          navMore.classList.toggle('open', open);
          navToggle.setAttribute('aria-expanded', String(open));
          navToggle.setAttribute('aria-label', open ? '收起菜单' : '打开更多菜单');
        };
        navToggle.addEventListener('click', () => {
          setOpen(!navMore.classList.contains('open'));
        });
        navMore.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => setOpen(false));
        });
        document.addEventListener('click', (event) => {
          if (!navMore.classList.contains('open')) return;
          if (event.target instanceof Node && !event.target.closest('.nav-inner')) {
            setOpen(false);
          }
        });
      }

      // 滚动渐入动画
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: var(--paper);
      }

      .nav-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 14px;
        padding-bottom: 10px;
      }

      .nav-top {
        display: contents;
      }

      .logo {
        display: flex;
        align-items: center;
        font-size: 1.35rem;
        font-weight: 900;
        text-decoration: none;
      }

      /* 汉堡按钮：仅移动端显示 */
      .nav-toggle {
        display: none;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 5px;
        width: 40px;
        height: 38px;
        background: var(--card-bg);
        border: 2.5px solid var(--ink);
        border-radius: 10px;
        box-shadow: 2px 3px 0 rgba(43, 43, 43, 0.85);
        cursor: pointer;
      }

      .nav-toggle span {
        display: block;
        width: 18px;
        height: 2.5px;
        background: var(--ink);
        border-radius: 2px;
        transition: transform 0.2s ease, opacity 0.2s ease;
      }

      .nav-toggle[aria-expanded='true'] span:nth-child(1) {
        transform: translateY(7.5px) rotate(45deg);
      }

      .nav-toggle[aria-expanded='true'] span:nth-child(2) {
        opacity: 0;
      }

      .nav-toggle[aria-expanded='true'] span:nth-child(3) {
        transform: translateY(-7.5px) rotate(-45deg);
      }

      /* 桌面端：「更多」分组直接平铺进导航行 */
      .nav-more {
        display: contents;
      }

      .nav-links {
        display: flex;
        gap: 26px;
      }

      .nav-links a {
        font-family: var(--font-hand);
        text-decoration: none;
        font-weight: 700;
        position: relative;
        padding: 2px 4px;
      }

      .nav-links a::after {
        content: '';
        position: absolute;
        left: 0;
        right: 100%;
        bottom: -2px;
        height: 3px;
        background: var(--accent);
        border-radius: 3px;
        transition: right 0.25s ease;
      }

      .nav-links a:hover::after {
        right: 0;
      }

      .nav-github {
        display: inline-flex;
        align-items: center;
        gap: 5px;
      }

      /* 代充推广入口：用主题色突出提醒 */
      .nav-topup {
        color: var(--accent);
      }

      .nav-github-icon {
        width: 17px;
        height: 17px;
      }

      .header-squiggle,
      .footer-squiggle {
        display: block;
        width: 100%;
        height: 12px;
      }

      .site-footer {
        margin-top: 90px;
        text-align: center;
      }

      .footer-inner {
        padding: 28px 24px 40px;
        opacity: 0.85;
      }

      .footer-github {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 10px;
        font-weight: 700;
        color: var(--ink);
        text-decoration: none;
        transition: color 0.15s ease, transform 0.15s ease;
      }

      .footer-github:hover {
        color: var(--accent);
        transform: translateY(-2px);
      }

      .footer-github-icon {
        width: 20px;
        height: 20px;
      }

      .footer-inner p {
        margin: 0;
      }

      @media (max-width: 640px) {
        .nav-inner {
          flex-direction: column;
          align-items: stretch;
          gap: 10px;
          padding-bottom: 12px;
        }

        .nav-top {
          display: flex;
          align-items: center;
          justify-content: space-between;
        }

        .nav-toggle {
          display: inline-flex;
        }

        /* 核心栏目：4 项均分一整行 */
        .nav-links {
          justify-content: space-between;
          flex-wrap: wrap;
          gap: 8px 0;
        }

        /* 「更多」下拉面板：默认收起，独占一行 */
        .nav-more {
          display: none;
          flex-basis: 100%;
          flex-direction: column;
          margin-top: 6px;
          padding: 6px 0;
          background: var(--card-bg);
          border: 2.5px solid var(--ink);
          border-radius: var(--squiggle);
          box-shadow: 4px 5px 0 rgba(43, 43, 43, 0.85);
        }

        .nav-more.open {
          display: flex;
        }

        .nav-more a {
          padding: 11px 18px;
        }

        .nav-more a + a {
          border-top: 2px dashed rgba(43, 43, 43, 0.25);
        }
      }
    </style>
  </body>
</html>
