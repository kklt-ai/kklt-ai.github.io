---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllArticles } from '../../data/articles';
import wechatQrcode from '../../assets/wechat_qrcode.JPG';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

// 最近两篇其他文章（含公众号文章），用于文末引流
const recentArticles = (await getAllArticles())
  .filter((a) => a.url !== `/blog/${post.id}/`)
  .slice(0, 2);
---

<BaseLayout title={`${post.data.title} · 卡卡罗特AI`} description={post.data.description}>
  <div class="container post-layout">
  <article class="post">
    <a href="/blog/" class="back-link">← 返回文章列表</a>
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <svg class="squiggle-underline" viewBox="0 0 220 14" aria-hidden="true">
        <path
          d="M4 8 Q20 2 36 8 T68 8 T100 8 T132 8 T164 8 T196 8 T216 8"
          fill="none"
          stroke="var(--accent)"
          stroke-width="4"
          stroke-linecap="round"
        />
      </svg>
      <div class="post-meta">
        <time class="post-date">
          <svg viewBox="0 0 24 24" aria-hidden="true" class="date-icon">
            <rect x="3" y="5" width="18" height="16" rx="3" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="M3 10 H21" stroke="currentColor" stroke-width="2" />
            <path d="M8 3 V7 M16 3 V7" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          {post.data.pubDate.toISOString().slice(0, 10)}
        </time>
        {post.data.tags.map((tag) => <span class="post-tag"># {tag}</span>)}
      </div>
      {post.data.description && <p class="post-desc">{post.data.description}</p>}
      <p class="post-notice">📌 公众号同名文章备份 · 原文失效时这里仍可阅读</p>
    </header>

    {
      post.data.wechatUrl && (
        <a
          href={post.data.wechatUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="wechat-cta"
        >
          <svg class="wechat-cta-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M9 3C4.9 3 1.6 5.8 1.6 9.2c0 1.9 1.1 3.6 2.7 4.8L3.5 16.4l2.6-1.3c.9.3 1.9.4 2.9.4h.6a5.3 5.3 0 0 1-.2-1.5c0-3.3 3.2-5.9 7-5.9h.5C16.3 5.1 13 3 9 3Z"
              fill="currentColor"
            />
            <path
              d="M22.4 14c0-2.7-2.7-4.9-6-4.9s-6 2.2-6 4.9 2.7 4.9 6 4.9c.7 0 1.4-.1 2-.3l1.9 1-.5-1.7c1.6-.9 2.6-2.3 2.6-3.9Z"
              fill="currentColor"
            />
          </svg>
          <span class="wechat-cta-text">
            <strong>点击阅读公众号原文</strong>
            <small>关注「卡卡罗特AI」，第一时间获取更新</small>
          </span>
          <span class="wechat-cta-arrow" aria-hidden="true">→</span>
        </a>
      )
    }

    <div class="prose">
      <Content />
    </div>

    {
      recentArticles.length > 0 && (
        <section class="read-more" aria-label="继续阅读">
          <h2 class="read-more-title">
            继续阅读
            <svg viewBox="0 0 40 40" aria-hidden="true" class="read-more-doodle">
              <path d="M6 20 Q14 8 20 20 T34 20" fill="none" stroke="var(--accent)" stroke-width="3" stroke-linecap="round" />
            </svg>
          </h2>
          <div class="read-more-grid">
            {recentArticles.map((a, i) => (
              <a
                href={a.url}
                target={a.external ? '_blank' : undefined}
                rel={a.external ? 'noopener noreferrer' : undefined}
                class={`read-more-card sketch-box ${i % 2 === 1 ? 'alt' : ''}`}
              >
                <time class="read-more-date">{a.date}</time>
                <h3>{a.title}</h3>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <footer class="post-footer">
      <a href="/blog/" class="sketch-btn">← 返回文章列表</a>
    </footer>
  </article>

  <aside class="side-panel" aria-label="侧边栏">
    <div class="follow-card sketch-box">
      <p class="follow-card-title">
        <svg class="follow-card-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M9 3C4.9 3 1.6 5.8 1.6 9.2c0 1.9 1.1 3.6 2.7 4.8L3.5 16.4l2.6-1.3c.9.3 1.9.4 2.9.4h.6a5.3 5.3 0 0 1-.2-1.5c0-3.3 3.2-5.9 7-5.9h.5C16.3 5.1 13 3 9 3Z"
            fill="currentColor"
          />
          <path
            d="M22.4 14c0-2.7-2.7-4.9-6-4.9s-6 2.2-6 4.9 2.7 4.9 6 4.9c.7 0 1.4-.1 2-.3l1.9 1-.5-1.7c1.6-.9 2.6-2.3 2.6-3.9Z"
            fill="currentColor"
          />
        </svg>
        关注公众号
      </p>
      <Image
        src={wechatQrcode}
        alt="卡卡罗特AI 公众号二维码"
        width={200}
        class="follow-card-qr"
      />
      <span class="follow-card-tip">微信扫码，关注「卡卡罗特AI」</span>
    </div>

    {
      tocHeadings.length > 0 && (
        <nav class="toc sketch-box">
          <p class="toc-title">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="toc-icon">
              <path d="M5 6 H8 M11 6 H19 M5 12 H8 M11 12 H19 M5 18 H8 M11 18 H19" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
            </svg>
            本文大纲
          </p>
          <ul>
            {tocHeadings.map((h) => (
              <li class={`toc-item depth-${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </aside>
  </div>
</BaseLayout>

<script>
  // 大纲滚动高亮：正文标题进入视口上方区域时点亮对应链接
  const links = document.querySelectorAll('.toc a');
  const headingEls = Array.from(links)
    .map((link) => {
      const id = decodeURIComponent(link.getAttribute('href')!.slice(1));
      return document.getElementById(id);
    })
    .filter((el): el is HTMLElement => el !== null);

  if (headingEls.length > 0) {
    const setActive = (id: string) => {
      links.forEach((link) => {
        link.classList.toggle('active', decodeURIComponent(link.getAttribute('href')!.slice(1)) === id);
      });
    };

    const onScroll = () => {
      const offset = 110;
      let current = headingEls[0];
      for (const el of headingEls) {
        if (el.getBoundingClientRect().top <= offset) current = el;
        else break;
      }
      setActive(current.id);
    };

    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  .post-layout {
    padding-top: 56px;
  }

  /* 详情页不用手写体，正文/标题更易读 */
  .post-layout h1,
  .post-layout h2,
  .post-layout h3,
  .post-layout h4,
  .prose :global(h1),
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    font-family: var(--font-apple);
  }

  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 44px;
    align-items: start;
  }

  .post {
    max-width: 760px;
    min-width: 0;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 28px;
    font-size: 0.95rem;
    font-weight: 700;
    color: rgba(43, 43, 43, 0.65);
    text-decoration: none;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .back-link:hover {
    color: var(--ink);
    transform: translateX(-3px);
  }

  /* ===== 右侧边栏 ===== */
  .side-panel {
    position: sticky;
    top: 92px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* ===== 关注公众号卡片 ===== */
  .follow-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 18px 16px;
    text-align: center;
  }

  .follow-card-title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 1.05rem;
    font-weight: 900;
    color: #07c160;
  }

  .follow-card-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .follow-card-qr {
    display: block;
    width: 168px;
    height: auto;
    border: 2px solid var(--ink);
    border-radius: 12px;
  }

  .follow-card-tip {
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.5;
    color: rgba(43, 43, 43, 0.62);
  }

  .toc {
    padding: 16px 18px 18px;
    max-height: calc(100vh - 130px);
    overflow-y: auto;
  }

  .toc-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.05rem;
    font-weight: 900;
    margin: 0 0 10px;
    padding-bottom: 8px;
    border-bottom: 2px dashed rgba(43, 43, 43, 0.3);
  }

  .toc-icon {
    width: 18px;
    height: 18px;
    color: var(--accent);
    flex-shrink: 0;
  }

  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc-item {
    margin: 2px 0;
  }

  .toc-item.depth-3 {
    padding-left: 16px;
  }

  .toc-item a {
    display: block;
    padding: 4px 8px;
    font-size: 0.85rem;
    line-height: 1.5;
    color: rgba(43, 43, 43, 0.65);
    text-decoration: none;
    border-radius: 8px;
    border-left: 3px solid transparent;
    transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
  }

  .toc-item a:hover {
    color: var(--ink);
    background: rgba(255, 214, 90, 0.3);
  }

  .toc-item a.active {
    color: var(--ink);
    font-weight: 700;
    background: rgba(255, 214, 90, 0.45);
    border-left-color: var(--accent);
  }

  @media (max-width: 1080px) {
    .post-layout {
      display: block;
    }

    .side-panel {
      position: static;
      margin-top: 44px;
    }

    /* 移动端隐藏大纲，仅保留关注公众号卡片 */
    .side-panel .toc {
      display: none;
    }

    .follow-card {
      max-width: 300px;
      margin: 0 auto;
    }
  }

  .post-header h1 {
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    line-height: 1.35;
    margin: 0;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 12px;
    margin-top: 20px;
  }

  .post-date {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 1rem;
    font-weight: 700;
    color: rgba(43, 43, 43, 0.75);
    font-variant-numeric: tabular-nums;
    margin-right: 6px;
  }

  .date-icon {
    width: 18px;
    height: 18px;
    color: var(--accent);
  }

  .post-tag {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 1px 12px;
    border: 2px solid var(--ink);
    border-radius: var(--squiggle);
    background: #d6e4ff;
    line-height: 1.7;
    transform: rotate(-1deg);
    transition: transform 0.2s ease;
  }

  .post-tag:nth-child(odd) {
    border-radius: var(--squiggle-2);
    transform: rotate(1deg);
  }

  .post-tag:nth-child(3n) {
    background: #dcedc8;
  }

  .post-tag:nth-child(3n + 1) {
    background: #ffe0b2;
  }

  .post-tag:hover {
    transform: rotate(0deg) translateY(-2px);
  }

  .post-desc {
    margin: 22px 0 0;
    padding: 14px 18px;
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgba(43, 43, 43, 0.78);
    background: rgba(255, 214, 90, 0.22);
    border: 2px dashed rgba(43, 43, 43, 0.5);
    border-radius: var(--squiggle);
  }

  .post-notice {
    margin: 20px 0 0;
    font-size: 0.8rem;
    line-height: 1.6;
    color: rgba(43, 43, 43, 0.5);
    letter-spacing: 0.02em;
  }

  /* ===== 公众号引流按钮 ===== */
  .wechat-cta {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 28px 0 0;
    padding: 16px 20px;
    text-decoration: none;
    color: #fff;
    background: #07c160;
    border: 2.5px solid var(--ink);
    border-radius: var(--squiggle);
    box-shadow: 4px 5px 0 rgba(43, 43, 43, 0.85);
    transform: rotate(-0.6deg);
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }

  .wechat-cta:hover {
    background: #06ad56;
    transform: rotate(0deg) translate(-2px, -2px);
    box-shadow: 7px 8px 0 rgba(43, 43, 43, 0.85);
  }

  .wechat-cta:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 rgba(43, 43, 43, 0.85);
  }

  .wechat-cta-icon {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
  }

  .wechat-cta-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    line-height: 1.35;
  }

  .wechat-cta-text strong {
    font-size: 1.1rem;
    font-weight: 900;
  }

  .wechat-cta-text small {
    font-size: 0.82rem;
    opacity: 0.92;
  }

  .wechat-cta-arrow {
    margin-left: auto;
    font-size: 1.5rem;
    font-weight: 900;
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  .wechat-cta:hover .wechat-cta-arrow {
    transform: translateX(4px);
  }

  /* ===== 文末推荐 ===== */
  .read-more {
    margin-top: 64px;
    padding-top: 32px;
    border-top: 3px dashed rgba(43, 43, 43, 0.3);
  }

  .read-more-title {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 1.4rem;
    margin: 0 0 20px;
  }

  .read-more-doodle {
    width: 32px;
    flex-shrink: 0;
  }

  .read-more-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .read-more-card {
    display: block;
    padding: 14px 18px 16px;
    text-decoration: none;
  }

  .read-more-card:hover {
    transform: translateY(-5px) rotate(-0.8deg);
    box-shadow: 6px 8px 0 rgba(43, 43, 43, 0.85);
  }

  .read-more-date {
    display: block;
    font-size: 0.8rem;
    opacity: 0.7;
    margin-bottom: 8px;
  }

  .read-more-card h3 {
    font-size: 1.05rem;
    line-height: 1.45;
    margin: 0;
  }

  @media (max-width: 640px) {
    .read-more-grid {
      grid-template-columns: 1fr;
    }
  }

  .post-footer {
    margin-top: 40px;
  }

  .prose {
    margin-top: 36px;
  }

  .prose :global(h2),
  .prose :global(h3) {
    scroll-margin-top: 96px;
  }

  .prose :global(h2) {
    font-size: 1.5rem;
    margin: 2.2em 0 0.7em;
    padding-left: 14px;
    border-left: 6px solid var(--accent-4);
  }

  .prose :global(h3) {
    font-size: 1.2rem;
    margin: 1.8em 0 0.6em;
  }

  .prose :global(p) {
    margin: 0.9em 0;
  }

  .prose :global(strong),
  .prose :global(b) {
    color: var(--accent);
    font-weight: 800;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0.9em 0;
    padding-left: 1.6em;
  }

  .prose :global(li) {
    margin: 0.35em 0;
  }

  .prose :global(blockquote) {
    margin: 1.2em 0;
    padding: 12px 20px;
    border: 2px dashed rgba(43, 43, 43, 0.45);
    border-radius: var(--squiggle);
    background: rgba(255, 214, 90, 0.18);
  }

  .prose :global(code) {
    font-family: 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.88em;
    background: rgba(67, 97, 238, 0.1);
    padding: 2px 6px;
    border-radius: 6px;
  }

  .prose :global(pre) {
    border: 2.5px solid var(--ink);
    border-radius: 14px;
    padding: 18px 20px;
    margin: 1.2em 0;
    box-shadow: 4px 5px 0 rgba(43, 43, 43, 0.85);
    overflow-x: auto;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
  }

  .prose :global(img) {
    border: 2.5px solid var(--ink);
    border-radius: 14px;
    margin: 1.2em auto;
  }

  .prose :global(a) {
    color: var(--accent-3);
    font-weight: 700;
    text-decoration-style: wavy;
    text-decoration-color: var(--accent-4);
    text-underline-offset: 4px;
  }

  .prose :global(hr) {
    border: none;
    border-top: 3px dashed rgba(43, 43, 43, 0.35);
    margin: 2em 0;
  }

  .prose :global(table) {
    border-collapse: collapse;
    width: 100%;
    margin: 1.2em 0;
  }

  .prose :global(th),
  .prose :global(td) {
    border: 2px solid var(--ink);
    padding: 8px 14px;
    text-align: left;
  }

  .prose :global(th) {
    background: rgba(255, 214, 90, 0.4);
  }
</style>
